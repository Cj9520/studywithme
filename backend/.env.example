# ============================================
# StudyBuddy Backend Environment Variables
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. NEVER commit .env file (already in .gitignore)
# 4. For production, use strong, unique secrets
#
# ============================================

# ============ CORE CONFIGURATION ============
NODE_ENV=development
# For production, set to: production
# This affects error messages, logging, and optimization

PORT=3001
# The port your backend server runs on
# For production, use port 3000 or let platform assign it

# ============ SECURITY ============
JWT_SECRET=your-super-secret-jwt-secret-change-this-in-production
# Generate a secure secret:
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Use a cryptographically secure random string (min 32 characters)

# ============ DATABASE ============
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/study-together?retryWrites=true&w=majority
# MongoDB Atlas connection string
# Format: mongodb+srv://USERNAME:PASSWORD@CLUSTER_NAME.mongodb.net/DATABASE_NAME
# Get this from MongoDB Atlas → Connect → Drivers
# 
# Steps to create:
# 1. Create cluster on MongoDB Atlas (https://www.mongodb.com/cloud/atlas)
# 2. Create database user
# 3. Whitelist IP address (0.0.0.0/0 for development, specific IPs for production)
# 4. Copy connection string and replace USERNAME, PASSWORD, CLUSTER_NAME

# ============ FRONTEND ============
FRONTEND_URL=http://localhost:5173
# URL where your frontend is hosted
# Development: http://localhost:5173
# Production: https://your-app.vercel.app (or wherever frontend is deployed)
# IMPORTANT: Must include protocol (http/https) and match exactly with deployed URL

# ============ EMAIL (Gmail with App Password) ============
EMAIL_USER=your-email@gmail.com
# Your Gmail address for sending OTP emails
# Example: student.app@gmail.com

EMAIL_PASS=your-16-character-app-password
# Gmail app password (NOT your regular password)
# 
# How to generate:
# 1. Enable 2-Factor Authentication on Gmail
# 2. Go to myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer"
# 4. Google will generate a 16-character password
# 5. Copy it here (remove spaces)

# ============ EMAIL (SMTP Configuration - Alternative) ============
SMTP_HOST=smtp.gmail.com
# SMTP server host for email service

SMTP_PORT=587
# SMTP port (587 for TLS, 465 for SSL)

SMTP_SECURE=false
# Set to true if using port 465, false for 587

SMTP_USER=your-smtp-user
# Usually same as EMAIL_USER for Gmail

SMTP_PASS=your-smtp-password
# Your SMTP password

# ============ OAUTH (Gmail - Advanced) ============
OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
# Google Cloud OAuth Client ID
# 
# How to set up:
# 1. Go to Google Cloud Console
# 2. Create new project
# 3. Enable Gmail API
# 4. Create OAuth 2.0 credentials (Desktop application)
# 5. Copy Client ID

OAUTH_CLIENT_SECRET=your-oauth-client-secret
# OAuth Client Secret from Google Cloud

OAUTH_REFRESH_TOKEN=your-oauth-refresh-token
# Refresh token for OAuth flow

# ============ NOTES FOR DEPLOYMENT ============
#
# RENDER DEPLOYMENT:
# - Copy all variables to Render dashboard → Environment
# - Variables are automatically injected at runtime
# - Secrets are encrypted
#
# RAILWAY DEPLOYMENT:
# - Same process as Render
# - Variables shown in dashboard → Variables tab
#
# HEROKU DEPLOYMENT:
# - Use: heroku config:set KEY=VALUE
# - Or set through dashboard → Settings → Config Vars
#
# SECURITY REMINDERS:
# - Never share your .env file
# - Rotate JWT_SECRET periodically
# - Use different secrets for dev/prod
# - Don't log sensitive values
# - Keep credentials out of version control
