# ============================================
# StudyBuddy Frontend Environment Variables
# ============================================
#
# INSTRUCTIONS:
# 1. Create .env file in frontend directory
# 2. Add these variables (use VITE_ prefix)
# 3. Restart dev server after changes
# 4. These are injected at BUILD time (not runtime)
#
# ============================================

# ============ API CONFIGURATION ============
VITE_API_URL=http://localhost:3001/api
# Your backend API URL
# Development: http://localhost:3001/api
# Production (Render): https://studybuddy-backend.onrender.com/api
# Production (Railway): https://your-railway-url/api
# 
# IMPORTANT:
# - Must include /api at the end
# - Must include protocol (http/https)
# - No trailing slash

VITE_SOCKET_URL=http://localhost:3001
# Your backend WebSocket URL
# Development: http://localhost:3001
# Production: https://your-backend-url (NO /api)
#
# IMPORTANT:
# - Must be root URL (no /api path)
# - Must include protocol (http/https)
# - No trailing slash

# ============ OPTIONAL ============
# Add other variables as needed for your app
# All variables MUST start with VITE_ to be accessible in frontend code

# Access in code:
# import.meta.env.VITE_API_URL
# import.meta.env.VITE_SOCKET_URL
